<launch>

<arg name="launch_rqt" default="false" />

<node pkg="ommpc_controller" type="ommpc_controller_example_node" name="ommpc_controller" output="screen" clear_params="true">
        <rosparam command="load" file="$(find ommpc_controller)/config/params.yaml" />
        <param name="takeoff_enabled" value="false" />
        <param name="command_or_hover" value="false" />
        <param name="land_enabled" value="false" />
	</node>
<node pkg="rqt_reconfigure" type="rqt_reconfigure" name="rqt_reconfigure" if="$(arg launch_rqt)">
  </node>
</launch>
